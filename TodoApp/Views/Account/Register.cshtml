@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="auth-card g-card">
    <div class="text-center mb-3">
        <div style="font-size:2.5rem">⚔️</div>
        <h2 class="mb-1">Create a new character</h2>
        <small class="muted">Start at level 1 and climb the leaderboards</small>
    </div>
    <form asp-action="Register" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="TimeZone" class="form-label"></label>
            <select asp-for="TimeZone" class="form-select" id="tz-select">
                @foreach (var (id, label) in TimeZones.Common)
                {
                    <option value="@id" selected="@(Model.TimeZone == id)">@label</option>
                }
            </select>
            <div class="form-text">Decides when your "new day" starts (dailies, deadlines, mana refill). Detected from your browser.</div>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-game w-100">Start your journey</button>
    </form>
    <p class="mt-3 mb-0 text-center muted">Already have a character? <a asp-action="Login">Log in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // preselect the browser's time zone when we offer it
        try {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone, sel = document.getElementById('tz-select');
            if (tz && sel && [...sel.options].some(o => o.value === tz)) sel.value = tz;
        } catch (e) { }
    </script>
}

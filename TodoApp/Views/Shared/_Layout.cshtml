@using System.Security.Claims
@inject CharacterService Players
@{
    var authed = User.Identity?.IsAuthenticated == true;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] names) => names.Contains(ctrl, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    var gold = 0;
    try
    {
        if (authed && Guid.TryParse(User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid))
            gold = await Players.GetGoldAsync(uid);
    }
    catch { /* never break the page chrome because of the game layer */ }
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0e1f" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="QuestLife" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="48x48" href="/icons/favicon-48.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <title>@ViewData["Title"] - QuestLife</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TodoApp.styles.css" asp-append-version="true" />
</head>
<body class="has-tabs">
    <!-- phone: slim top bar -->
    <header class="m-top d-lg-none">
        <a class="m-brand" asp-controller="Home" asp-action="Index">⚔️ QuestLife</a>
        <div class="m-top-right">
            @if (authed)
            {
                <span class="gold-chip" title="Gold">🪙 @gold.ToString("N0")</span>
                <a class="avatar m-avatar" asp-controller="Profile" asp-action="Me" title="My profile">@User.Identity!.Name![0].ToString().ToUpper()</a>
            }
            else
            {
                <a class="btn btn-game btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
            }
        </div>
    </header>

    <!-- desktop: full navigation -->
    <header class="d-none d-lg-block sticky-top" style="z-index:1030">
        <nav class="navbar navbar-expand-lg game-nav sticky-top">
            <div class="page d-flex flex-wrap align-items-center w-100">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">⚔️ QuestLife</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">🏆 Leaderboards</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Raid" asp-action="Index">🐲 Raid Boss</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Shop" asp-action="Index">🛒 Shop</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Players" asp-action="Index">🔎 Players</a></li>
                        @if (authed)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">🎯 Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Character" asp-action="Index">🧙 Character</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Pet" asp-action="Index">🐾 Pets</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Achievements" asp-action="Index">🎖️ Achievements</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (authed)
                        {
                            <li class="nav-item"><span class="gold-chip" title="Gold">🪙 @gold.ToString("N0")</span></li>
                            <li class="nav-item">
                                <a class="nav-player" asp-controller="Profile" asp-action="Me" title="My profile"><span class="avatar">@User.Identity!.Name![0].ToString().ToUpper()</span>@User.Identity.Name</a>
                            </li>
                            <li class="nav-item"><a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Settings" title="Settings">⚙️</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-game btn-sm" asp-controller="Account" asp-action="Register">Play now</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    @if (TempData["Toast"] is string toast)
    {
        <div class="toast-quest" role="status">✨ @toast</div>
    }
    @if (TempData["ToastError"] is string toastError)
    {
        <div class="toast-quest toast-error" role="alert">⚠️ @toastError</div>
    }
    <div class="page">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="game-footer">
        <div class="page">&copy; 2026 QuestLife · Turn your life into a game</div>
    </footer>

    <!-- install suggestion (shown by pwa.js only when the app can be installed) -->
    <div id="install-banner" class="install-banner" hidden>
        <span class="ib-icon">⚔️</span>
        <span class="ib-text">Install QuestLife for a full-screen app experience.</span>
        <button type="button" class="ib-install btn-buy" hidden>Install</button>
        <button type="button" id="install-dismiss" class="ib-close" aria-label="Dismiss">✕</button>
    </div>

    <!-- phone: bottom tab bar -->
    <nav class="m-tabs d-lg-none" aria-label="Main navigation">
        @if (authed)
        {
            <a class="m-tab @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><span class="ico">🎯</span>Quests</a>
            <a class="m-tab @Active("Raid")" asp-controller="Raid" asp-action="Index"><span class="ico">🐲</span>Raid</a>
            <a class="m-tab @Active("Shop")" asp-controller="Shop" asp-action="Index"><span class="ico">🛒</span>Shop</a>
            <a class="m-tab @Active("Character")" asp-controller="Character" asp-action="Index"><span class="ico">🧙</span>Hero</a>
            <button class="m-tab" type="button" data-bs-toggle="offcanvas" data-bs-target="#moreSheet" aria-controls="moreSheet"><span class="ico">☰</span>More</button>
        }
        else
        {
            <a class="m-tab @Active("Home")" asp-controller="Home" asp-action="Index"><span class="ico">🏆</span>Boards</a>
            <a class="m-tab @Active("Raid")" asp-controller="Raid" asp-action="Index"><span class="ico">🐲</span>Raid</a>
            <a class="m-tab @Active("Shop")" asp-controller="Shop" asp-action="Index"><span class="ico">🛒</span>Shop</a>
            <a class="m-tab @Active("Players", "Profile")" asp-controller="Players" asp-action="Index"><span class="ico">🔎</span>Players</a>
            <a class="m-tab @Active("Account")" asp-controller="Account" asp-action="Register"><span class="ico">⚔️</span>Join</a>
        }
    </nav>

    @if (authed)
    {
        <div class="offcanvas offcanvas-bottom m-sheet d-lg-none" tabindex="-1" id="moreSheet" aria-labelledby="moreSheetLabel">
            <div class="m-sheet-grip"></div>
            <div class="m-sheet-head" id="moreSheetLabel">@User.Identity!.Name</div>
            <div class="m-sheet-grid">
                <a asp-controller="Profile" asp-action="Me"><span class="ico">👤</span>Profile</a>
                <a asp-controller="Pet" asp-action="Index"><span class="ico">🐾</span>Pets</a>
                <a asp-controller="Achievements" asp-action="Index"><span class="ico">🎖️</span>Achievements</a>
                <a asp-controller="Home" asp-action="Index"><span class="ico">🏆</span>Leaderboards</a>
                <a asp-controller="Players" asp-action="Index"><span class="ico">🔎</span>Players</a>
                <a asp-controller="Account" asp-action="Settings"><span class="ico">⚙️</span>Settings</a>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-sheet-logout">
                <button type="submit" class="btn btn-ghost w-100">Log out</button>
            </form>
        </div>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/mobile.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

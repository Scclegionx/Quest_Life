@model DashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard";
    var today = Model.Today;
    var ci = CultureInfo.InvariantCulture;

    string PriorityCss(TaskPriority p) => p switch { TaskPriority.High => "pri-high", TaskPriority.Medium => "pri-medium", _ => "pri-low" };
    int Pct(int value, int max) => max <= 0 ? 0 : Math.Clamp(value * 100 / max, 0, 100);
}

<!-- ===== Character ===== -->
<section class="player-card mt-4">
    <div class="level-ring" style="--p:@Model.PercentToNext">
        <div class="level-ring-inner"><small>LV</small><strong>@Model.Level</strong></div>
    </div>
    <div class="player-info">
        <h1>@Model.Username</h1>
        <span class="title-chip">⚜️ @Model.LevelTitle</span>
        <div class="vital"><span class="vital-label">❤️ HP</span>
            <div class="xp-bar vital-hp"><div class="xp-fill" style="width:@(Pct(Model.Hp, Model.MaxHp))%"></div></div>
            <span class="vital-num">@Model.Hp / @Model.MaxHp</span></div>
        <div class="vital"><span class="vital-label">💧 MP</span>
            <div class="xp-bar vital-mp"><div class="xp-fill" style="width:@(Pct(Model.Mana, Model.MaxMana))%"></div></div>
            <span class="vital-num">@Model.Mana / @Model.MaxMana</span></div>
        <div class="vital"><span class="vital-label">⭐ EXP</span>
            <div class="xp-bar"><div class="xp-fill" style="width:@(Model.PercentToNext)%"></div></div>
            <span class="vital-num">@Model.Exp.ToString("N0") / @Model.NextLevelXp.ToString("N0")</span></div>
    </div>
    <div class="player-stats">
        <div class="stat-pill"><strong style="color:var(--gold)">🪙 @Model.Gold.ToString("N0")</strong><span>gold</span></div>
        <div class="stat-pill fire"><strong>🔥 @Model.Streak</strong><span>day streak</span></div>
        <a class="stat-pill raid-pill @(Model.InRaid ? "in" : "")" asp-controller="Raid" asp-action="Index">
            <strong>@(Model.InRaid ? "⚔️ In raid" : "🐲 Raid")</strong><span>@(Model.InRaid ? "every task hits the boss" : "tap to join")</span>
        </a>
        <a class="stat-pill raid-pill" asp-controller="Profile" asp-action="Me">
            <strong>👤 Profile</strong><span>see how others see you</span>
        </a>
    </div>
</section>

<!-- ===== Task board ===== -->
<h2 class="section-title">⚔️ Your quests</h2>

<!-- phone: one task list at a time -->
@{
    var dailiesLeft = Model.Dailies.Count(d => !Model.DoneDailyIds.Contains(d.Id));
}
<div class="task-tabs d-lg-none" role="tablist">
    <button type="button" class="task-tab" data-tab="habits" role="tab">🔁 Habits <span class="count">@Model.Habits.Count</span></button>
    <button type="button" class="task-tab" data-tab="dailies" role="tab">📅 Dailies <span class="count">@dailiesLeft/@Model.Dailies.Count</span></button>
    <button type="button" class="task-tab active" data-tab="todos" role="tab">📌 To-Dos <span class="count">@Model.Todos.Count</span></button>
</div>

<div class="row g-4">
    <!-- HABITS -->
    <div class="col-xl-4 col-lg-6 task-col-wrap" data-col="habits">
        <div class="g-card task-col">
            <div class="task-col-head">
                <h2>🔁 Habits</h2>
                <a class="btn-small" asp-controller="Tasks" asp-action="Create" asp-route-type="Habit">+ Add</a>
            </div>
            @if (Model.Habits.Count == 0) { <div class="muted small">No habits yet.</div> }
            @foreach (var t in Model.Habits)
            {
                var counts = Model.HabitCounts.GetValueOrDefault(t.Id);
                <div class="task-card @PriorityCss(t.Priority)">
                    <form asp-controller="Tasks" asp-action="Habit" method="post">
                        <input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="positive" value="true" />
                        <button type="submit" class="hab-btn plus" title="Did well (reward)">+</button>
                    </form>
                    <div class="task-body">
                        <div class="task-title">@t.Title</div>
                        @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="task-desc">@t.Description</div> }
                        <div class="task-meta">
                            <span class="stars" title="@TaskLabels.Difficulty(t.Difficulty)">@TaskLabels.Stars(t.Difficulty)</span>
                            <span class="count-pos">+@counts.Positive</span>
                            <span class="count-neg">−@counts.Negative</span>
                        </div>
                    </div>
                    <form asp-controller="Tasks" asp-action="Habit" method="post">
                        <input type="hidden" name="id" value="@t.Id" /><input type="hidden" name="positive" value="false" />
                        <button type="submit" class="hab-btn minus" title="Slipped (lose HP)">−</button>
                    </form>
                    <div class="task-tools">
                        <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@t.Id" title="Edit">✏️</a>
                        <form asp-controller="Tasks" asp-action="Delete" method="post" onsubmit="return confirm('Delete this task?')">
                            <input type="hidden" name="id" value="@t.Id" /><button type="submit" title="Delete">🗑️</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- DAILIES -->
    <div class="col-xl-4 col-lg-6 task-col-wrap" data-col="dailies">
        <div class="g-card task-col">
            <div class="task-col-head">
                <h2>📅 Dailies</h2>
                <a class="btn-small" asp-controller="Tasks" asp-action="Create" asp-route-type="Daily">+ Add</a>
            </div>
            @if (Model.Dailies.Count == 0) { <div class="muted small">No dailies yet.</div> }
            @foreach (var t in Model.Dailies)
            {
                var rep = t.Repeat ?? RepeatType.Daily;
                var done = Model.DoneDailyIds.Contains(t.Id);
                <div class="task-card @PriorityCss(t.Priority) @(done ? "is-done" : "")">
                    <form asp-controller="Tasks" asp-action="Complete" method="post">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="check-btn @(done ? "checked" : "")" disabled="@done" title="Complete">@(done ? "✓" : "")</button>
                    </form>
                    <div class="task-body">
                        <div class="task-title">@t.Title</div>
                        @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="task-desc">@t.Description</div> }
                        <div class="task-meta">
                            <span class="stars" title="@TaskLabels.Difficulty(t.Difficulty)">@TaskLabels.Stars(t.Difficulty)</span>
                            <span class="chip">🔄 @TaskLabels.Repeat(rep)</span>
                            @if (t.Streak > 0) { <span class="chip fire">🔥 @t.Streak</span> }
                        </div>
                    </div>
                    <div class="task-tools">
                        <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@t.Id" title="Edit">✏️</a>
                        <form asp-controller="Tasks" asp-action="Delete" method="post" onsubmit="return confirm('Delete this task?')">
                            <input type="hidden" name="id" value="@t.Id" /><button type="submit" title="Delete">🗑️</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- TODOS -->
    <div class="col-xl-4 col-lg-12 task-col-wrap is-active" data-col="todos">
        <div class="g-card task-col">
            <div class="task-col-head">
                <h2>📌 To-Dos</h2>
                <a class="btn-small" asp-controller="Tasks" asp-action="Create" asp-route-type="Todo">+ Add</a>
            </div>
            @if (Model.Todos.Count == 0) { <div class="muted small">Nothing left to do. 🎉</div> }
            @foreach (var t in Model.Todos)
            {
                var overdue = t.Deadline is { } due && due < today;
                var dueToday = t.Deadline == today;
                <div class="task-card @PriorityCss(t.Priority) @(overdue ? "is-overdue" : "")">
                    <form asp-controller="Tasks" asp-action="Complete" method="post">
                        <input type="hidden" name="id" value="@t.Id" />
                        <button type="submit" class="check-btn" title="Complete"></button>
                    </form>
                    <div class="task-body">
                        <div class="task-title">@t.Title</div>
                        @if (!string.IsNullOrWhiteSpace(t.Description)) { <div class="task-desc">@t.Description</div> }
                        <div class="task-meta">
                            <span class="stars" title="@TaskLabels.Difficulty(t.Difficulty)">@TaskLabels.Stars(t.Difficulty)</span>
                            @if (t.Category is { } cat)
                            {
                                var info = Categories.Get(cat);
                                <span class="chip cat-@info.Slug" style="color:var(--accent)">@info.Emoji @t.Effort?.Num() @info.UnitFor(t.Effort ?? 0)</span>
                            }
                            @if (t.Deadline is { } d)
                            {
                                <span class="due-chip @(overdue ? "late" : dueToday ? "today" : "")">⏰ @d.ToString("MMM d", ci)</span>
                            }
                            <span class="chip">@TaskLabels.Priority(t.Priority)</span>
                        </div>
                    </div>
                    <div class="task-tools">
                        <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@t.Id" title="Edit">✏️</a>
                        <form asp-controller="Tasks" asp-action="Delete" method="post" onsubmit="return confirm('Delete this task?')">
                            <input type="hidden" name="id" value="@t.Id" /><button type="submit" title="Delete">🗑️</button>
                        </form>
                    </div>
                </div>
            }
            @if (Model.DoneTodos.Count > 0)
            {
                <details class="mt-2">
                    <summary class="muted small">Recently completed (@Model.DoneTodos.Count)</summary>
                    @foreach (var t in Model.DoneTodos)
                    {
                        <div class="task-card is-done">
                            <div class="check-btn checked">✓</div>
                            <div class="task-body"><div class="task-title">@t.Title</div></div>
                            <div class="task-tools">
                                <form asp-controller="Tasks" asp-action="Delete" method="post">
                                    <input type="hidden" name="id" value="@t.Id" /><button type="submit" title="Delete">🗑️</button>
                                </form>
                            </div>
                        </div>
                    }
                </details>
            }
        </div>
    </div>
</div>

<!-- ===== Insights ===== -->
<h2 class="section-title">📈 Insights</h2>
<partial name="_ActivityCharts" model="Model.Charts" />

<div class="g-card mt-4">
    <div class="d-flex justify-content-between align-items-baseline flex-wrap">
        <h2 class="mb-1">🔥 Activity — last @Model.Charts.HeatWeeks weeks</h2>
        <span class="muted small">@Model.Charts.ActiveDays active days · @Model.Charts.TotalCompletions tasks completed</span>
    </div>
    <partial name="_Heatmap" model="Model.Charts" />
</div>

<!-- ===== This week ===== -->
<h2 class="section-title">🏆 This week's standings</h2>
<div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 g-4">
    @foreach (var card in Model.Cards)
    {
        var info = card.Info;
        <div class="col">
            <div class="g-card quest-card cat-@info.Slug">
                <div class="quest-top">
                    <div class="board-icon">@info.Emoji</div>
                    <div class="flex-grow-1">
                        <h3>@info.Name</h3>
                        <small>@info.BoardName</small>
                    </div>
                </div>
                <div class="quest-numbers">
                    <div><strong>@card.WeekTotal.Num()</strong><span>@info.Unit this week</span></div>
                    <div class="text-end"><strong>@card.AllTotal.Num()</strong><span>@info.Unit total</span></div>
                </div>
                @if (card.WeekRank is { } rank)
                {
                    <span class="rank-tag">@(rank == 1 ? "👑" : "🏅") Rank @rank of @card.WeekPlayers</span>
                }
                else
                {
                    <span class="rank-tag">Not ranked this week</span>
                }
                <a class="btn-small mt-3 d-block text-center" asp-controller="Tasks" asp-action="Create" asp-route-type="Todo" asp-route-category="@info.Key">+ Add a @info.Name to-do</a>
            </div>
        </div>
    }
</div>

<!-- ===== Feed and badges ===== -->
<div class="row g-4 mt-1">
    <div class="col-xl-5">
        <div class="g-card">
            <h2>📖 Recent achievements</h2>
            @if (Model.Recent.Count == 0)
            {
                <div class="muted">Complete a to-do with a category to log your first feat!</div>
            }
            else
            {
                @foreach (var log in Model.Recent)
                {
                    var info = Categories.Get(log.Category);
                    <div class="feed-item">
                        <span class="ico">@info.Emoji</span>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@info.Name · +@log.Amount.Num() @info.UnitFor(log.Amount)</div>
                            <small class="muted">@(log.Note is null ? "" : log.Note + " · ")@Model.Clock.ToLocal(log.LoggedAt).ToString("MMM d, HH:mm", ci)</small>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="col-xl-7">
        <div class="g-card">
            <h2>🏅 Badges</h2>
            <div class="badge-grid">
                @foreach (var b in Model.Badges)
                {
                    <div class="badge-tile @(b.Unlocked ? "unlocked" : "locked")" title="@b.Description">
                        <span class="ico">@b.Icon</span>
                        <strong>@b.Name</strong>
                        <small>@b.Description</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<a id="fab" class="fab d-lg-none" asp-controller="Tasks" asp-action="Create" asp-route-type="Todo" aria-label="Add a task">+</a>

<p class="text-center muted small mt-4">Data source: @Model.DataSource@(Model.Deaths > 0 ? $" · 💀 Fallen {Model.Deaths} {(Model.Deaths == 1 ? "time" : "times")}" : "")</p>

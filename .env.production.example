# Copy this file to ".env" ON THE SERVER, fill in the values and protect it:  chmod 600 .env
# Never commit the real .env to git.

# --- website address (DNS must already point to the server) ---
DOMAIN=questlife.example.com

# --- database ---
POSTGRES_DB=questlife
POSTGRES_USER=questlife
# Use letters and digits only (no ; = or spaces: it is embedded in a connection string). Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# --- Discord (optional, see docs/discord-setup.md) ---
DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_ID=
# Set to true for the first start (or whenever the commands change), then back to false
DISCORD_REGISTER_COMMANDS=false
